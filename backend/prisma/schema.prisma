// =============================================================================
// Race Nations — Schéma Prisma (PostgreSQL)
// Source de vérité : docs/invariants.md, docs/api.md, docs/betting.md,
//                    docs/game-design.md, docs/cahier-des-charges.md.
//
// Règles structurantes (rappel des invariants dans le code) :
//  - INV-01 : toute valeur monétaire est un Int (centimes pour HARD, unités pour SOFT). JAMAIS Float/Decimal.
//  - INV-02 : CHECK balance >= 0 posés par la migration 0004_constraints.
//  - INV-03 : tout mouvement d'argent passe par wallet.repository.ts (SELECT ... FOR UPDATE + WalletTransaction).
//  - INV-04 : idempotencyKey UNIQUE sur WalletTransaction / BetSettlement / WebhookEvent.
//  - INV-06 : ledgers append-only (triggers immuables migration 0002_audit_immutable + garde applicative).
//  - INV-07 : colonnes SOFT (credits/gems/tokens) et HARD (hardCents) séparées, jamais mélangées au règlement.
//  - INV-22 : les enums ci-dessous sont l'alphabet des machines à états (backend/src/common/state-machines/).
//  - INV-29 : createdAt/updatedAt horodatés serveur ; le code métier utilise Clock.now(), jamais new Date().
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enumérations — miroir exact de shared/api-contracts/src/enums.ts
// -----------------------------------------------------------------------------

enum UserRole {
  PLAYER
  MODERATOR
  ADMIN
  SYSTEM
}

enum OwnerType {
  PLAYER
  HOUSE
  SYSTEM
}

enum SoftCurrency {
  CREDITS
  GEMS
  TOKENS
}

enum WalletTransactionType {
  DEPOSIT
  PURCHASE
  REWARD
  BET_ESCROW
  BET_PAYOUT
  BET_REFUND
  HOUSE_FEE
  HOUSE_REVERSAL
  REVERSAL
  ADMIN_ADJUSTMENT
}

enum Currency {
  SOFT
  HARD
}

enum TicketStatus {
  QUEUED
  MATCHED
  JOINED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum QueueMode {
  RANKED_1V1
  RANKED_FFA
  QUICK_RACE
  BATTLE_ROYALE
  TOURNAMENT
  CLAN_WARS
  PRACTICE
}

enum MatchStatus {
  WAITING_FOR_PLAYERS
  LOADING
  IN_PROGRESS
  FINISHED
  FINISHED_VALIDATED // terminal — déclenche settlement bets (INV-24)
  INVALIDATED        // terminal — résultat rejeté (INV-25) → litige paris (INV-18/19)
}

enum MatchOutcome {
  VICTORY
  DEFEAT
  DRAW
  ABANDON    // pertes selon INV-17 (-30 PL, cap min 0)
  DISQUALIFIED
}

enum Division {
  BRONZE   // 0-499
  ARGENT   // 500-999
  OR       // 1000-1499
  PLATINE  // 1500-1999
  DIAMANT  // 2000-2499
  MAITRE   // 2500-2999
  LEGEND   // 3000+
}

enum GameServerStatus {
  REGISTERED
  RESERVED
  DRAINING
  OFFLINE
}

enum PaymentStatus {
  CREATED
  PROVIDER_PENDING
  SUCCEEDED // terminal (INV-23)
  FAILED    // terminal
  CANCELLED // terminal
}

enum PaymentProvider {
  STRIPE
  FLUTTERWAVE
  GOOGLE_PLAY
  APPLE_IAP
  HUAWEI_IAP
}

enum TicketItemType {
  TOURNAMENT
  MATCHDAY
  CLAN_WARS
}

enum BetMarketStatus {
  OPEN
  CHALLENGED
  LOCKED
  SETTLING
  SETTLED   // terminal — UNIQUE(marketId) dans BetSettlement (INV-14)
  DISPUTED  // gel ≤ 72 h (INV-19)
  CANCELLED
}

enum BetStatus {
  PENDING
  ACCEPTED
  ESCROWED // fonds immobilisés (INV-15)
  RUNNING
  WON
  LOST
  PUSH     // égalité : remboursement intégral, houseCut = 0 (INV-16)
  REFUNDED
  VOIDED
}

enum BetResult {
  WIN
  LOSS
  PUSH
  REFUND
  VOID
  CHEAT_REVERSAL // INV-18
}

enum DisputeReason {
  CHEAT_SUSPECTED
  RESULT_MISMATCH
  DISCONNECT_DISPUTE
  SERVER_FAULT
  OTHER
}

enum SanctionStatus {
  ISSUED
  ACTIVE
  APPEALED
  LIFTED
  UPHELD
}

enum SanctionType {
  WARN
  CHAT_MUTE
  BET_RESTRICTION
  TEMP_BAN_7D // réputation < 10 (INV-21)
  PERM_BAN
  REWARD_CLAWBACK
}

enum LicenseStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DENIED
}

enum BettingActivationStatus {
  DISABLED // bloqué légalement (FR/USA)
  PENDING  // licence en cours (TG HARD LONATO, NG, KE, CI, SN, GH)
  ENABLED_SOFT
  ENABLED_HARD
}

// -----------------------------------------------------------------------------
// Identité & joueur
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String // argon2id
  role         UserRole @default(PLAYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player     Player?
  refresh    RefreshToken[]
  adminAudit AdminAuditLog[]
  sanctionsIssued Sanction[] @relation("SanctionIssuer")

  @@map("users")
}

model Player {
  id              String @id @default(uuid())
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id])
  username        String @unique
  countryCode     String // résidence (gating juridiction, INV-20)
  nationality     String // pays représenté — DÉFINITIF après 1ʳᵉ course classée (INV-31)
  nationalityLocked Boolean @default(false)

  level      Int      @default(1)
  xp         Int      @default(0) // seuils pl-table.json
  plPoints   Int      @default(0) // cap min 0 (INV-31), +25/-20/0/-30
  division   Division @default(BRONZE)
  reputation Int      @default(50) // 0-100 ; <30 → pas de HARD (INV-21)

  // KYC paris HARD (INV-21)
  ageVerifiedAt      DateTime?
  birthDateConfirmed Boolean   @default(false)
  kycDocumentRef     String? // référence chiffrée objet storage — jamais le document en DB

  // préférences
  preferredLanguage String  @default("fr")
  chatGlobalEnabled Boolean @default(true)
  marketingOptIn    Boolean @default(false)
  acceptedTermsAt   DateTime?
  acceptedPrivacyAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet         Wallet?
  tickets        MatchmakingTicket[]
  matchEntries   MatchPlayer[]
  bets           Bet[]
  marketsCreated BetMarket[]   @relation("MarketCreator")
  marketsJoined  BetMarket[]   @relation("MarketOpponent")
  sanctions      Sanction[]
  friendsGiven   FriendRelation[] @relation("FriendA")
  friendsTaken   FriendRelation[] @relation("FriendB")
  clanMembership ClanMembership?
  ownedVehicles  VehicleOwnership[]

  @@index([nationality, plPoints]) // leaderboards par pays (api.md §10)
  @@index([division, plPoints])
  @@map("players")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique // SHA-256 du token ; jamais le token en clair
  family    Int       @default(0) // bump à rotation complète → révocation famille si REUSED
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, family])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// Wallets & ledger (INV-01..INV-07)
// -----------------------------------------------------------------------------

/// Un wallet par joueur (+ un wallet HOUSE unique seedé par 0006_house_wallet).
/// Soldes entiers non négatifs (CHECK en 0004_constraints). SOFT/HARD cloisonnés (INV-07).
model Wallet {
  id        String    @id @default(uuid())
  playerId  String?   @unique // null uniquement pour le wallet HOUSE/SYSTEM
  ownerType OwnerType @default(PLAYER)

  credits   Int @default(0) // SOFT
  gems      Int @default(0) // SOFT
  tokens    Int @default(0) // SOFT
  hardCents Int @default(0) // HARD — centimes réels (INV-01)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player       Player?             @relation(fields: [playerId], references: [id])
  transactions WalletTransaction[] @relation("WalletLedger")

  @@map("wallets")
}

/// Ledger append-only (INV-06). amountSigned < 0 = débit, > 0 = crédit.
/// balanceAfter = solde de la devise concernée APRÈS le mouvement (auditability).
model WalletTransaction {
  id             String                @id @default(uuid())
  walletId       String
  wallet         Wallet                @relation("WalletLedger", fields: [walletId], references: [id])
  type           WalletTransactionType
  currencyKind   SoftCurrency          // devise touchée (jamais de mix INV-07)
  amountSigned   Int // entier signé
  balanceAfter   Int // entier, >= 0 (CHECK 0004)
  idempotencyKey String                @unique // INV-04
  refType        String? // 'BET_MARKET' | 'PAYMENT' | 'MATCH' | 'ADMIN' …
  refId          String?
  reversalOfId   String?               // chaîne de contre-écriture (INV-06)
  reversalOf     WalletTransaction?    @relation("ReversalChain", fields: [reversalOfId], references: [id])
  reversals      WalletTransaction[]   @relation("ReversalChain")
  createdAt      DateTime              @default(now())

  @@index([walletId, createdAt])
  @@index([refType, refId])
  @@map("wallet_transactions")
}

// -----------------------------------------------------------------------------
// Matchmaking — machine Ticket (INV-22)
// -----------------------------------------------------------------------------

model MatchmakingTicket {
  id          String       @id @default(uuid())
  playerId    String
  player      Player       @relation(fields: [playerId], references: [id])
  mode        QueueMode
  status      TicketStatus @default(QUEUED)
  plAtQueue   Int // fenêtre PL ±200→±500 selon mode (CdC)
  matchId     String?
  match       Match?       @relation(fields: [matchId], references: [id])
  requestedAt DateTime     @default(now())
  matchedAt   DateTime?
  expiresAt   DateTime? // max 120 s classée / 60 s rapide / 120 s BR
  cancelReason String?

  @@index([mode, status, plAtQueue]) // scan worker matchmaking
  @@index([playerId, status])
  @@map("matchmaking_tickets")
}

// -----------------------------------------------------------------------------
// Matches & résultats (validation serveur INV-25, settlement INV-31/32)
// -----------------------------------------------------------------------------

model Match {
  id      String      @id @default(uuid())
  status  MatchStatus @default(WAITING_FOR_PLAYERS)
  mode    QueueMode
  trackId String // circuit (Lomé, Accra, Lagos, Dakar, Paris, Tokyo, Abidjan, Nairobi, Casablanca, Dubaï)
  weather String?
  serverId String?
  server   GameServer? @relation(fields: [serverId], references: [id])

  startedAt         DateTime?
  finishedAt        DateTime?
  validatedAt       DateTime? // FINISHED_VALIDATED — gate INV-24
  invalidatedReason String?

  betMarkets BetMarket[]
  players    MatchPlayer[]
  result     ResultPayload?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("matches")
}

/// Participation d'un joueur à un match + récompenses calculées SERVEUR (INV-32).
model MatchPlayer {
  id        String       @id @default(uuid())
  matchId   String
  match     Match        @relation(fields: [matchId], references: [id])
  playerId  String
  player    Player       @relation(fields: [playerId], references: [id])
  position  Int?         // 1..8 (grille récompenses CdC)
  outcome   MatchOutcome?
  finishMs  Int?         // temps de course en millisecondes (entier, jamais float)
  driftPoints Int        @default(0)
  bestLapMs   Int?

  rewardsCredits Int @default(0) // grille position + bonus (floor, INV-32)
  rewardsGems    Int @default(0)
  rewardsXp      Int @default(0)
  rewardsTokens  Int @default(0)
  plDelta        Int @default(0) // +25 / -20 / 0 / -30 (INV-31)

  joinedAt              DateTime  @default(now())
  disconnectedAt        DateTime?
  reconnectDeadlineAt   DateTime? // +30 s tolérance (INV-17)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@map("match_players")
}

/// Payload brut signé par le game server, conservé pour audit/anti-triche (INV-25).
model ResultPayload {
  id            String   @id @default(uuid())
  matchId       String   @unique
  match         Match    @relation(fields: [matchId], references: [id])
  body          Json     // positions, checkpoints, vitesses max, nonce, timestamp
  signature     String   // HMAC-SHA256 vérifié timingSafeEqual (INV-26)
  nonce         String   @unique // anti-replay
  receivedAt    DateTime @default(now())
  valid         Boolean  @default(false)
  invalidReason String?

  @@map("result_payloads")
}

// -----------------------------------------------------------------------------
// Flotte game servers
// -----------------------------------------------------------------------------

model GameServer {
  id              String           @id @default(uuid())
  hostname        String           @unique
  wsUrl           String
  region          String
  status          GameServerStatus @default(REGISTERED)
  capacity        Int              @default(8)
  activeMatches   Int              @default(0)
  sharedSecretRef String // référence secret (KMS), jamais le secret en clair
  lastHeartbeatAt DateTime?
  drainedAt       DateTime?

  matches Match[]

  @@index([status, region])
  @@map("game_servers")
}

// -----------------------------------------------------------------------------
// Paiements (HARD money) & tickets
// -----------------------------------------------------------------------------

model Payment {
  id             String          @id @default(uuid())
  playerId       String
  provider       PaymentProvider
  status         PaymentStatus   @default(CREATED)
  amountCents    Int // bornes CdC : 1 000–100 000 cts (CHECK 0004)
  currencyCode   String          @default("EUR")
  jurisdiction   String // countryCode au moment du checkout (plafonds mensuels/annuels)
  providerRef    String?         @unique // payment_intent / FLW tx_ref
  idempotencyKey String          @unique // INV-04
  succeededAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([playerId, status])
  @@map("payments")
}

/// Tickets d'événements (Tournois / Matchday / Clan Wars) : 500 crédits OU 10 gemmes.
model EventTicket {
  id        String         @id @default(uuid())
  playerId  String
  kind      TicketItemType
  paidWith  SoftCurrency // CREDITS ou GEMS
  amountPaid Int          // 500 ou 10 (entiers)
  eventRef  String?
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([playerId, kind])
  @@map("event_tickets")
}

// -----------------------------------------------------------------------------
// Webhooks (signature INV-26, idempotence INV-04)
// -----------------------------------------------------------------------------

model WebhookEvent {
  id             String   @id @default(uuid())
  provider       String // 'STRIPE' | 'FLUTTERWAVE' | 'GAMESERVER'
  externalId     String // event id provider — base de la clé d'idempotence
  idempotencyKey String   @unique // INV-04 (ex. stripe:<event.id>)
  payload        Json
  signatureValid Boolean  @default(false)
  processedAt    DateTime?
  failureReason  String?
  receivedAt     DateTime @default(now())

  @@index([provider, receivedAt])
  @@map("webhook_events")
}

// -----------------------------------------------------------------------------
// Betting — pari mutuel 1v1 (docs/betting.md)
// -----------------------------------------------------------------------------

/// Marché de pari lié à un match 1v1 (ou tournoi N outcomes).
/// houseEdgeBps figé à la création (contrat économique, cf. betting.config.ts).
model BetMarket {
  id         String  @id @default(uuid())
  creatorId  String
  creator    Player  @relation("MarketCreator", fields: [creatorId], references: [id])
  opponentId String?
  opponent   Player? @relation("MarketOpponent", fields: [opponentId], references: [id])
  matchId    String?
  match      Match?  @relation(fields: [matchId], references: [id])
  tournamentRef String? // variante tournoi (betting.md §9), SOFT uniquement v1

  currency         Currency
  stake            Int // mises identiques obligatoires (INV-10) ; CHECK stake>0 (0004)
  totalPool        Int @default(0) // = somme des stakes engagés (INV-08)
  houseEdgeBps     Int @default(500) // 5 % (cahier §3.10)
  houseCutEstimate Int @default(0)   // floor(totalPool*bps/10000) recalculé à chaque engagement

  status        BetMarketStatus @default(OPEN)
  public        Boolean         @default(true)
  trackId       String
  vehicleId     String?

  disputedAt    DateTime?     // gel ≤ 72 h (INV-19)
  disputeReason DisputeReason?
  cancelledAt   DateTime?

  bets       Bet[]
  settlement BetSettlement? // 1:1 — UNIQUE marketId (INV-14)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, currency, trackId]) // GET /markets filtres (api.md §5)
  @@index([creatorId])
  @@index([opponentId])
  @@map("bet_markets")
}

/// Position d'un joueur sur un marché. Escrow tracé via WalletTransaction BET_ESCROW (INV-15).
model Bet {
  id       String    @id @default(uuid())
  marketId String
  market   BetMarket @relation(fields: [marketId], references: [id])
  playerId String
  player   Player    @relation(fields: [playerId], references: [id])

  side   Int       @default(0) // camp 0/1 (N outcomes tournoi)
  stake  Int                   // CHECK stake>0 (0004) ; == market.stake (INV-10)
  status BetStatus @default(PENDING)
  result BetResult?
  payout Int       @default(0) // floor(stake × netPool / winningStake) (INV-09)
  escrowTxId String? @unique   // lien → WalletTransaction BET_ESCROW (INV-15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marketId, playerId]) // auto-pari / double position impossible
  @@index([playerId, status])    // GET /bets/me
  @@index([marketId, side])      // aggregation winningStake au settlement
  @@map("bets")
}

/// Settlement d'un marché — INSERT UNIQUE(marketId) = verrou anti double-settlement (INV-14).
/// payouts = JSON { "<betId>": <cents|credits>, ... } entiers ; residual = résidu de floor → House (INV-09/13).
model BetSettlement {
  id             String    @id @default(uuid())
  marketId       String    @unique // INV-14
  market         BetMarket @relation(fields: [marketId], references: [id])
  totalPool      Int
  houseCut       Int                 // 0 si push (INV-16)
  netPool        Int
  payouts        Json
  residual       Int        @default(0) // crédité House (INV-09)
  idempotencyKey String     @unique     // settle:<marketId> (INV-04)
  settledBy      String?               // userId admin si settlement manuel (INV-28)
  settledAt      DateTime   @default(now())

  @@map("bet_settlements")
}

/// Snapshot quotidien du House Wallet pour réconciliation comptable (observability.md §8).
model HouseBalanceSnapshot {
  id                String   @id @default(uuid())
  day               DateTime @unique @db.Date // 00:00 UTC
  balanceCents      Int
  escrowOutstanding Int
  cumulativeFees    Int
  takenAt           DateTime @default(now())

  @@map("house_balance_snapshots")
}

// -----------------------------------------------------------------------------
// Modération, sanctions, audit
// -----------------------------------------------------------------------------

model Sanction {
  id          String           @id @default(uuid())
  playerId    String
  player      Player           @relation(fields: [playerId], references: [id])
  type        SanctionType
  status      SanctionStatus   @default(ISSUED)
  reason      String
  evidenceRef String? // lien audit/result payload (INV-18)
  issuedById  String
  issuedBy    User             @relation("SanctionIssuer", fields: [issuedById], references: [id])
  startsAt    DateTime         @default(now())
  endsAt      DateTime? // TEMP_BAN_7D : +7 j
  liftedAt    DateTime?
  appealNote  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([playerId, status])
  @@map("sanctions")
}

/// Journal d'audit admin append-only (api.md §9 ; triggers immuables migration 0002).
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String // 'BET_MANUAL_SETTLE' | 'SANCTION_ISSUE' | 'HOUSE_REVERSE' | 'SERVER_DRAIN' …
  targetType String // 'BetMarket' | 'Sanction' | 'HouseWallet' | 'GameServer' …
  targetId   String
  metadata   Json?
  requestId  String // corrélation observabilité
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

// -----------------------------------------------------------------------------
// Social (cadre minimal — détail Phase ultérieure)
// -----------------------------------------------------------------------------

model FriendRelation {
  id        String   @id @default(uuid())
  playerAId String
  playerBId String
  playerA   Player   @relation("FriendA", fields: [playerAId], references: [id])
  playerB   Player   @relation("FriendB", fields: [playerBId], references: [id])
  createdAt DateTime @default(now())

  @@unique([playerAId, playerBId]) // max 200 amis (compté app)
  @@map("friend_relations")
}

model Clan {
  id               String   @id @default(uuid())
  name             String   @unique
  tag              String   @unique
  ownerId          String
  creationCostGems Int      @default(500) // CdC §8.2
  level            Int      @default(1)
  createdAt        DateTime @default(now())

  members ClanMembership[]

  @@map("clans")
}

model ClanMembership {
  playerId String   @id @unique // max 50 membres (compté app)
  player   Player   @relation(fields: [playerId], references: [id])
  clanId   String
  clan     Clan     @relation(fields: [clanId], references: [id])
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  @@index([clanId])
  @@map("clan_memberships")
}

model VehicleOwnership {
  id          String   @id @default(uuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id])
  vehicleId   String // réf shared/balance/vehicles.json
  category    String // D/C/B/A/S
  purchasedAt DateTime @default(now())

  @@unique([playerId, vehicleId])
  @@map("vehicle_ownerships")
}

// -----------------------------------------------------------------------------
// Réglementaire — licences & activation par pays (INV-20, docs/betting-legal.md)
// Table seedée par scripts/seed-prod.sh (matrice game-modes.md §10.5)
// -----------------------------------------------------------------------------

model JurisdictionConfig {
  countryCode         String                @id // ISO 3166-1 alpha-2 majuscule
  countryName         String
  licenseAuthority    String? // 'LONATO' | 'NLRC' | 'BCLB' | 'LONACI' | 'LONASE' | 'GCA' | 'ANJ' | 'UIGEA'
  licenseStatus       LicenseStatus         @default(DENIED)
  bettingActivation   BettingActivationStatus @default(DISABLED)
  dailyHardLimitCents   Int? // plafond journalier HARD par juridiction (null = pas de HARD)
  monthlyHardLimitCents Int?
  yearlyHardLimitCents  Int?
  legalNotes          String? // ex. "Bloqué (ANJ)" FR, "Bloqué (UIGEA)" USA
  updatedAt           DateTime              @updatedAt

  @@map("jurisdiction_configs")
}
